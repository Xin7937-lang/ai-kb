# ===== 应用 =====
# 首次启动时使用：启动后建议清空（已写入数据库 settings 表）
APP_PASSWORD=

# 用于签发 JWT Cookie，必填，生成方式：openssl rand -hex 32
JWT_SECRET=

# 用于 AES-256-GCM 加密模型 API Key，必填，生成方式：openssl rand -hex 32
ENCRYPTION_KEY=

# ===== 路径（容器内绝对路径，开发时可改）=====
DB_PATH=/app/data/kb.db
UPLOADS_DIR=/app/uploads
BACKUPS_DIR=/app/backups

# ===== 运行 =====
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
